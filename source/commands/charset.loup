@mode(host.dual)

# The characters of a SET as a set, for membership tests: its members as
# sorted, disjoint ranges, optionally complemented. Codes 0..255 are also
# kept in a table, since most input is ASCII.
#
# Runtime: host.dual. Compiled into the native binary build/tr by `make
# build`; `loup run source/main.loup` interprets the same code.

from commands.sets import (Elem, class_members);

pub class CharSet {
    # (first, last) of each run of members: sorted, disjoint, not adjacent.
    var bounds: list[(int, int)] = [];
    pub var complemented: bool = false;
    # Membership of the codes 0..255, with the complement applied.
    var low: list[bool] = [];

    # A set of the members of `elems`, complemented if asked. The factory
    # sits on the class: callers write CharSet.of(...).
    pub static func of(elems: list[Elem], invert: bool): CharSet {
        let s = CharSet();
        safe {
            s.build(elems, invert);
        }
        return s;
    }

    # Fills the set with the members of `elems` (GNU's set_initialize).
    pub modifier func build(elems: list[Elem], invert: bool): void {
        var firsts: list[int] = [];
        var lasts: list[int] = [];
        for (e in elems) {
            match e {
                Elem.Single(c) => {
                    firsts.push(c);
                    lasts.push(c);
                },
                Elem.Span(first, last) => {
                    firsts.push(first);
                    lasts.push(last);
                },
                Elem.CharClass(cls) => {
                    for (c in class_members(cls)) {
                        firsts.push(c);
                        lasts.push(c);
                    }
                },
                Elem.Equiv(c) => {
                    firsts.push(c);
                    lasts.push(c);
                },
                Elem.Repeat(c, count) => {
                    if (count > 0) {
                        firsts.push(c);
                        lasts.push(c);
                    }
                },
            }
        }
        # Insertion sort by first character (sets are small).
        var k = 1;
        while (k < firsts.len()) {
            let f = firsts[k];
            let l = lasts[k];
            var j = k - 1;
            while (j >= 0 and firsts[j] > f) {
                firsts[j + 1] = firsts[j];
                lasts[j + 1] = lasts[j];
                j -= 1;
            }
            firsts[j + 1] = f;
            lasts[j + 1] = l;
            k += 1;
        }
        # Merge overlapping and adjacent ranges, so that the binary search
        # in in_bounds sees disjoint ones.
        var merged: list[(int, int)] = [];
        k = 0;
        while (k < firsts.len()) {
            let m = merged.len();
            if (m > 0 and firsts[k] <= merged[m - 1].1 + 1) {
                if (lasts[k] > merged[m - 1].1) {
                    merged[m - 1] = (merged[m - 1].0, lasts[k]);
                }
            } else {
                merged.push((firsts[k], lasts[k]));
            }
            k += 1;
        }
        this.bounds = merged;
        this.complemented = invert;
        var table: list[bool] = [];
        for (code in 0..256) {
            table.push(this.in_bounds(code) != invert);
        }
        this.low = table;
    }

    # Whether `code` is in the uncomplemented set (a binary search over the
    # runs).
    reads func in_bounds(code: int): bool {
        var lo = 0;
        var hi = this.bounds.len();
        while (lo < hi) {
            let mid = (lo + hi) / 2;
            let (first, last) = this.bounds[mid];
            if (code < first) {
                hi = mid;
            } else if (code > last) {
                lo = mid + 1;
            } else {
                return true;
            }
        }
        return false;
    }

    # The query methods only read the set: `reads` says so, and the
    # checker holds them to it.
    pub reads func contains(code: int): bool {
        if (code >= 0 and code < 256) {
            return this.low[code];
        }
        return this.in_bounds(code) != this.complemented;
    }

    # How many members of the uncomplemented set are below `code`. Called
    # for every character -c translates, so it indexes the runs: natively a
    # destructuring `for` over tuples costs memory per pass, an indexed
    # `let (first, last) = ...` does not.
    pub reads func count_below(code: int): int {
        var count = 0;
        for (k in 0..this.bounds.len()) {
            let (first, last) = this.bounds[k];
            if (first >= code) {
                return count;
            }
            if (last < code) {
                count += last - first + 1;
            } else {
                count += code - first;
            }
        }
        return count;
    }

    # How many distinct members the uncomplemented set has.
    pub reads func size(): int {
        var count = 0;
        for ((first, last) in this.bounds) {
            count += last - first + 1;
        }
        return count;
    }
}
