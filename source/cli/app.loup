@mode(host.dual)

from appinfo import (APP_NAME, EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.plan import (make_plan);
from commands.tr import (run_tr);

# Parses argv, runs tr and returns the exit status.
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            printErr(i"{$ APP_NAME $}: {$ msg $}");
            printErr(i"Try '{$ APP_NAME $} --help' for more information.");
            return EXIT_USAGE;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    # A bad SET is reported without the "Try" line, as GNU tr does; its
    # warnings come first either way.
    var warnings: list[string] = [];
    let made = make_plan(opts, edits: warnings);
    for (w in warnings) {
        printErr(i"{$ APP_NAME $}: {$ w $}");
    }
    let plan = match made {
        Ok(p) => p,
        Err(msg) => {
            printErr(i"{$ APP_NAME $}: {$ msg $}");
            return EXIT_FAILURE;
        },
    };

    try {
        return run_tr(plan);
    } catch (Exception as e) {
        printErr(i"{$ APP_NAME $}: {$ e.message $}");
        return EXIT_FAILURE;
    }
}
