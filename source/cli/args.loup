@mode(host.dual)

# Command-line parsing for tr. Options are scanned with getopt's rules in
# its "+" mode, as GNU tr does: the first operand ends the options, so in
# `tr a -d` the `-d` is STRING2. Then the number of operands is checked
# against the options, with GNU tr's messages.
#
# Runtime: host.dual. Compiled into the native binary build/tr by `make
# build`; `loup run source/main.loup` interprets the same code.

from cli.getopt import (OptSpec, opt, scan_options);
from cli.quote import (quote);

# A class, not a struct: it is built here and read in other modules, and
# classes keep their layout across modules in native builds.
pub class Options {
    pub var help: bool = false;
    pub var version: bool = false;
    pub var complement: bool = false;
    pub var delete_chars: bool = false;
    pub var squeeze_repeats: bool = false;
    pub var truncate_set1: bool = false;
    pub var set1: string = "";
    pub var set2: string = "";
    pub var has_set2: bool = false;

    # Whether tr translates: STRING2 is given and -d is not.
    pub func translating(): bool {
        return this.has_set2 and !this.delete_chars;
    }
}

# One entry of the option table; none of tr's options takes a value. Each
# entry names only what it has, and the key defaults to the letter, or to
# the long name when there is no letter. A helper in this module rather
# than defaults on cli.getopt's opt(): natively, named arguments to a
# function of another module crash, and loup run binds them by position.
func spec(letter: string = "", long_name: string = "", key: string = ""): OptSpec {
    let k = if (key != "") { key } else if (letter != "") { letter } else { long_name };
    return opt(letter, long_name, false, k);
}

func specs(): list[OptSpec] {
    return [
        spec(letter = "c", long_name = "complement"),
        spec(letter = "C", key = "c"),
        spec(letter = "d", long_name = "delete"),
        spec(letter = "s", long_name = "squeeze-repeats"),
        spec(letter = "t", long_name = "truncate-set1"),
        # Undocumented in GNU tr (AIX compatibility: the C locale); a no-op here.
        spec(letter = "A"),
        spec(long_name = "help"),
        spec(long_name = "version"),
    ];
}

pub func parse_args(argv: list[string]): Result[Options, string] {
    let scan = match scan_options(argv, specs(), true) {
        Ok(s) => s,
        Err(msg) => {
            return Err(msg);
        },
    };

    let opts = Options();
    for (h in scan.hits) {
        let key = h.hit_key;
        safe {
            if (key == "help") {
                opts.help = true;
            } else if (key == "version") {
                opts.version = true;
            } else if (key == "c") {
                opts.complement = true;
            } else if (key == "d") {
                opts.delete_chars = true;
            } else if (key == "s") {
                opts.squeeze_repeats = true;
            } else if (key == "t") {
                opts.truncate_set1 = true;
            }
        }
        if (opts.help or opts.version) {
            return Ok(opts);
        }
    }

    # GNU: -d and -s together, or neither, need two strings; -d alone takes
    # one; -s alone takes one or two.
    let operands = scan.operands;
    let n = operands.len();
    let both_or_neither = opts.delete_chars == opts.squeeze_repeats;
    let min_operands = if (both_or_neither) { 2 } else { 1 };
    let max_operands = if (opts.delete_chars and !opts.squeeze_repeats) { 1 } else { 2 };
    if (n < min_operands) {
        if (n == 0) {
            return Err("missing operand");
        }
        let why = if (opts.squeeze_repeats) {
            "Two strings must be given when both deleting and squeezing repeats."
        } else {
            "Two strings must be given when translating."
        };
        return Err("missing operand after " + quote(operands[n - 1]) + "\n" + why);
    }
    if (n > max_operands) {
        var msg = "extra operand " + quote(operands[max_operands]);
        if (n == 2) {
            msg = msg + "\nOnly one string may be given when deleting without squeezing repeats.";
        }
        return Err(msg);
    }
    safe {
        opts.set1 = operands[0];
        if (n == 2) {
            opts.set2 = operands[1];
            opts.has_set2 = true;
        }
    }
    return Ok(opts);
}
