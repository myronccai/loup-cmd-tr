@mode(host.dual)

# Application identity for tr: name, version, summary and exit statuses.
# Keep APP_NAME and APP_VERSION in step with `name` and `version` in
# package.lppkg.
#
# Runtime: host.dual. Constants only. Compiled into build/tr by `make
# build`; `loup run source/main.loup` interprets the same code.

pub const APP_NAME: string = "tr";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Translate, squeeze or delete characters (a Loup recreation of GNU tr).";

# Exit statuses returned by main(). GNU tr reports usage errors and bad
# SETs with 1, the same status as a read error.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
pub const EXIT_USAGE: int = 1;
