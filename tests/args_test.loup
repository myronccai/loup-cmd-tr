@mode(host.dual)

# Unit tests for tr's argument parsing (cli.args): translation, flags,
# the first operand ending the options, and operand counts and errors.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this
# file with Stage0 (`loup-bootstrap test --no-parallel`, source/ on
# LOUPPATH), one test per `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from cli.args import (Options, parse_args);

func parse(argv: list[string]): Options {
    return parse_args(argv).unwrap();
}

func error_of(argv: list[string]): string {
    return parse_args(argv).unwrap_err();
}

func test_translate(): void {
    let opts = parse(["a-z", "A-Z"]);
    expectEq(opts.set1, "a-z", "SET1");
    expectEq(opts.set2, "A-Z", "SET2");
    expect(opts.has_set2, "two sets");
    expect(opts.translating(), "translating");
    expect(!opts.complement and !opts.delete_chars and !opts.squeeze_repeats and !opts.truncate_set1, "no flags");
}

func test_flags(): void {
    let opts = parse(["-cs", "-t", "--delete", "a", "b"]);
    expect(opts.complement, "-c");
    expect(opts.squeeze_repeats, "-s");
    expect(opts.truncate_set1, "-t");
    expect(opts.delete_chars, "--delete");
    expect(!opts.translating(), "-d does not translate");
    expect(parse(["-C", "-d", "a"]).complement, "-C");
    expect(parse(["--comp", "-d", "a"]).complement, "abbreviated --complement");
    expect(!parse(["-A", "a", "b"]).complement, "-A is accepted");
}

func test_first_operand_ends_options(): void {
    let opts = parse(["l", "-d"]);
    expectEq(opts.set2, "-d", "-d is SET2");
    expect(!opts.delete_chars, "not an option");
    expectEq(parse(["--", "-a", "b"]).set1, "-a", "after --");
}

func test_operand_counts(): void {
    expect(parse(["-d", "a"]).set1 == "a", "-d takes one");
    expect(!parse(["-s", "a"]).has_set2, "-s takes one");
    expect(parse(["-s", "a", "b"]).has_set2, "or two");
    expect(parse(["-ds", "a", "b"]).has_set2, "-ds takes two");
}

func test_operand_errors(): void {
    let none: list[string] = [];
    expectEq(error_of(none), "missing operand", "nothing");
    expectEq(error_of(["-d"]), "missing operand", "-d alone");
    expectEq(error_of(["a"]), "missing operand after 'a'\nTwo strings must be given when translating.", "one string");
    expectEq(error_of(["-ds", "a"]), "missing operand after 'a'\nTwo strings must be given when both deleting and squeezing repeats.", "-ds one string");
    expectEq(error_of(["-d", "a", "b"]), "extra operand 'b'\nOnly one string may be given when deleting without squeezing repeats.", "-d two strings");
    expectEq(error_of(["a", "b", "c"]), "extra operand 'c'", "three strings");
    expectEq(error_of(["it's"]), "missing operand after 'it\\'s'\nTwo strings must be given when translating.", "quoted");
}

func test_help_and_version(): void {
    expect(parse(["--help", "-x"]).help, "--help first");
    expect(parse(["--version"]).version, "--version");
    expectEq(error_of(["-x", "--help"]), "invalid option -- 'x'", "error first");
}
