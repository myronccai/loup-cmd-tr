@mode(host.dual)

# Exit statuses of whole command lines that do not read standard input.
# These tests print the program's messages.

from debug.assert import (expectEq);
from appinfo import (EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from cli.app import (run);

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
}

func test_help_succeeds(): void {
    expectEq(run(["--help"]), EXIT_OK, "--help");
}

func test_usage_errors(): void {
    let none: list[string] = [];
    expectEq(run(none), EXIT_USAGE, "no operands");
    expectEq(run(["-x"]), EXIT_USAGE, "bad option");
}

func test_bad_set_fails(): void {
    expectEq(run(["z-a", "x"]), EXIT_FAILURE, "reversed range");
    expectEq(run(["a", "[:digit:]"]), EXIT_FAILURE, "class in SET2");
}
